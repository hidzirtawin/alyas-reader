{
  "name": "alyas-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Alya's Reader — a local-first audiobook studio that turns your EPUB, PDF, Word and text files into MP3s with fast Piper voices.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ebook",
    "comic",
    "epub",
    "pdf",
    "cbz",
    "cbr",
    "docx",
    "tts",
    "audiobook",
    "mp3",
    "audio-export",
    "reader",
    "piper"
  ],
  "license": "MIT",
  "homepage": "https://hidzirtawin.github.io/alyas-reader/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidzirtawin/alyas-reader.git"
  }
}
